---
---
<section id="contacto" class="section-padding relative">
  <div class="container mx-auto px-4 space-y-12">
    <!-- Action Channels -->
    <div class="grid md:grid-cols-2 gap-8">
      <!-- WhatsApp Box -->
      <div class="card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 bg-gradient-to-br from-white/90 via-[#FAF6F0] to-white/80 border-[#E8DFC8]">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-emerald-light text-emerald border border-emerald/20">
            <span>💬</span> WhatsApp Directo
          </div>
          <h3 class="text-2xl sm:text-3xl font-serif font-semibold text-ink-deep">Atención Personalizada</h3>
          <p class="text-sm text-ink-medium max-w-sm leading-relaxed">
            Resuelve consultas sobre disponibilidad, medidas o cotiza una pieza exclusiva con Nicolás.
          </p>
        </div>
        <a 
          href="https://wa.me/56931983075" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="button-primary whitespace-nowrap !py-3 !px-6 text-sm" 
          id="contact-whatsapp-btn"
        >
          Escribir por WhatsApp
        </a>
      </div>

      <!-- Instagram Box -->
      <div class="card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 bg-gradient-to-br from-white/90 via-[#FAF6F0] to-white/80 border-[#E8DFC8]">
        <div class="space-y-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold tracking-wider uppercase bg-quartz-mist text-quartz border border-quartz/30">
            <span>📸</span> Instagram
          </div>
          <h3 class="text-2xl sm:text-3xl font-serif font-semibold text-ink-deep">Galería Viva & Taller</h3>
          <p class="text-sm text-ink-medium max-w-sm leading-relaxed">
            Sigue el día a día en el taller de Vicuña, procesos de fundición y novedades de la colección.
          </p>
        </div>
        <a 
          href="https://instagram.com/elquijoyas" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="button-ghost whitespace-nowrap !py-3 !px-6 text-sm" 
          id="contact-instagram-btn"
        >
          Visitar @elquijoyas
        </a>
      </div>
    </div>

    <!-- Contact Form Card -->
    <div class="card p-8 md:p-12 grid lg:grid-cols-12 gap-10 items-start bg-white/90 border-[#E5D4C0] shadow-watercolor">
      <div class="lg:col-span-5 space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold tracking-widest uppercase border border-quartz/30 bg-white/70 backdrop-blur-sm text-emerald">
          <span>✧</span> Escríbenos
        </div>
        <h3 class="text-3xl sm:text-4xl font-serif font-semibold text-ink-deep" id="contact-form-title">
          Cuéntanos tu Idea o Encargo Especial
        </h3>
        <p class="text-sm sm:text-base text-ink-medium leading-relaxed" id="contact-form-desc">
          ¿Tienes en mente una joya personalizada, un anillo de compromiso o un regalo único con minerales del Valle de Elqui? Escríbenos y diseñamos juntos la pieza soñada.
        </p>
        <div class="pt-4 border-t border-[#EBDDCB] space-y-2 text-xs text-ink-muted">
          <p class="flex items-center gap-2">
            <span>⏱️</span> Respuesta habitual dentro del mismo día laboral.
          </p>
          <p class="flex items-center gap-2">
            <span>📦</span> Envíos asegurados a todo Chile desde Vicuña.
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form class="space-y-4" onsubmit="event.preventDefault(); window.open(`https://wa.me/56931983075?text=${encodeURIComponent('Hola Nicolás, me contacto desde la web. Mi nombre es ' + (document.getElementById('name') as HTMLInputElement)?.value + '. Mensaje: ' + (document.getElementById('message') as HTMLTextAreaElement)?.value)}`, '_blank');">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5" for="name">
                Nombre Completo
              </label>
              <input 
                id="name" 
                name="name" 
                type="text" 
                required 
                placeholder="Ej. Camila Morales"
                class="w-full rounded-2xl border border-[#E0CCB4] bg-[#FAF6F0]/80 px-4 py-3.5 text-sm text-ink-deep placeholder:text-ink-muted/50 focus:outline-none focus:ring-2 focus:ring-emerald focus:bg-white transition"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5" for="email">
                Correo Electrónico
              </label>
              <input 
                id="email" 
                name="email" 
                type="email" 
                required 
                placeholder="tu@correo.com"
                class="w-full rounded-2xl border border-[#E0CCB4] bg-[#FAF6F0]/80 px-4 py-3.5 text-sm text-ink-deep placeholder:text-ink-muted/50 focus:outline-none focus:ring-2 focus:ring-emerald focus:bg-white transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-ink-muted mb-1.5" for="message">
              ¿Qué pieza o consulta tienes en mente?
            </label>
            <textarea 
              id="message" 
              name="message" 
              rows="4" 
              required
              placeholder="Cuéntanos el tipo de joya, metales o gemas de tu preferencia..."
              class="w-full rounded-2xl border border-[#E0CCB4] bg-[#FAF6F0]/80 px-4 py-3.5 text-sm text-ink-deep placeholder:text-ink-muted/50 focus:outline-none focus:ring-2 focus:ring-emerald focus:bg-white transition"
            ></textarea>
          </div>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
            <button type="submit" class="button-primary w-full sm:w-auto text-sm">
              <span>✉️</span> Enviar Consulta Directa
            </button>
            <p class="text-[11px] text-ink-muted italic text-center sm:text-right">
              Te responderemos a la brevedad por WhatsApp o correo.
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
